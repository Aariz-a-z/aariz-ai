# ---------------------------------------------------------------------------
# Environment template.
#
#   cp .env.example .env.local        (then edit .env.local)
#
# This file IS committed and must contain placeholders only — never real
# secrets, keys or tokens. `.env.local` is git-ignored and holds real values.
#
# Nothing below is read by application code yet. Level 1 is user interface
# only; these variables are declared now so the configuration shape is fixed
# before any provider code is written.
# ---------------------------------------------------------------------------

# --- Deployment modes --------------------------------------- (see: Level 15)
# Which of these values change between local development and a public
# deployment is documented in docs/DEPLOYMENT.md, along with what each mode can
# and cannot do.
#
# The short version: OLLAMA_BASE_URL below defaults to localhost, which is
# correct for development and WRONG for any remotely hosted frontend — a hosting
# provider's server resolving "localhost" reaches its own machine, not yours.
#
# There is deliberately no DEPLOYMENT_MODE variable. The mode describes where
# things run; the application behaves the same either way.

# --- LLM provider -------------------------------- (used: Level 3, 19)
# Selects which adapter src/lib/llm.ts loads.
#
# MODEL SWITCHING (Level 19). src/lib/llm.ts is the ONLY module in the
# application that reads the three variables in this block. Changing the model
# therefore changes nothing else: not the UI, not retrieval, not the database,
# not authentication, not ingestion, not the conversation system. Verified by
# `npm run verify:model-switch`, which runs the same question through two
# different models and asserts the retrieved chunks come back identical.
#
# It is RUNTIME configuration: a restart picks it up, a rebuild is not needed
# (unlike WIDGET_ALLOWED_ORIGINS below, which is baked at build time). The
# process environment also takes precedence over this file, so
# `OLLAMA_MODEL=llama3.2:1b npm start` overrides it for one run.
#
# "gemini" is a recognised provider name with no adapter behind it: the factory
# answers 501 not_implemented rather than falling back to something else. That
# is deliberate — Roadmap Rule 6 forbids a paid API being required, so the
# cloud path stays an anticipated seam rather than a dependency. Implementing
# it needs a GEMINI_API_KEY that this project does not ship and does not want.
# =============================================================================
# VERCEL / PUBLIC DEMO  (Mode A3 — see docs/DEPLOYMENT.md)
# =============================================================================
# Set LLM_PROVIDER=disabled for a public deployment that cannot reach a model.
#
# WHY THIS EXISTS. A Vercel function cannot reach the Ollama on your laptop.
# `localhost` inside a serverless container is the container itself, so
# OLLAMA_BASE_URL is not merely wrong there, it is meaningless. Rather than let
# every request spend its timeout reaching for an address that cannot answer,
# `disabled` switches inference off explicitly and the application says so.
#
# WHAT IT DISABLES. Everything that needs the model server, which is more than
# chat: document upload embeds each chunk before storing it, so it depends on
# the same server. Both refuse with 503 and one honest sentence. Nothing is
# faked — no canned answers, no placeholder text dressed up as model output.
#
# WHAT STILL WORKS. Sign-up and sign-in, listing and reading conversations,
# listing documents, /admin, /api/health, /embed, and every security control.
#
# There is NO NEXT_PUBLIC_ variable for this. The pages read it on the server
# and pass a single boolean to the browser, so no configuration is published.
#
#   local development :  LLM_PROVIDER=ollama     (unchanged, uses Ollama)
#   Vercel demo       :  LLM_PROVIDER=disabled
LLM_PROVIDER=ollama

# --- What to set in the Vercel dashboard ------------------------------------
# Project -> Settings -> Environment Variables. All of these are SERVER-ONLY.
# Never add NEXT_PUBLIC_ to any of them.
#
#   REQUIRED
#     LLM_PROVIDER              disabled
#     SUPABASE_URL              your project URL
#     SUPABASE_SERVICE_ROLE_KEY your service-role key   <- bypasses RLS
#     SUPABASE_ANON_KEY         your anon key
#
#   REQUIRED IF YOU WANT THAT FEATURE
#     ADMIN_EMAILS              your address, or /admin 404s for everyone
#     WIDGET_ALLOWED_ORIGINS    the origin that may embed /embed
#                               MUST be set before the build — Next bakes
#                               frame-ancestors into the routes manifest, so
#                               changing it later needs a REDEPLOY, not a
#                               restart.
#
#   DO NOT SET ON VERCEL
#     OLLAMA_BASE_URL           unreachable from a serverless function
#     OLLAMA_MODEL              unused when LLM_PROVIDER=disabled
#     ZERO_API_MODE             it enforces LOCAL-only inference and would
#                               reject `disabled`; leave it unset in the demo
#
#   OPTIONAL
#     RATE_LIMIT_*              defaults apply. See the serverless caveat in
#                               docs/DEPLOYMENT.md: counters are per-instance,
#                               so limits are weaker on serverless than on a
#                               single long-lived process.

# Address of the local Ollama server. This is the default for a local install.
OLLAMA_BASE_URL=http://localhost:11434

# Model tag to run. Selected at Level 2 by benchmarking candidates on the
# target hardware. Fallback for lower latency: llama3.2:1b
#
# Changing this is the whole of a model switch. Note that the Level 11
# evaluation baseline (96.2% retrieval hit rate, ~83-90% answer correctness)
# was measured on llama3.2:3b; a smaller model will retrieve identically and
# answer less well, because retrieval does not depend on this value at all.
#
# This is NOT the embedding model. OLLAMA_EMBED_MODEL is separate, and changing
# THAT invalidates every stored vector and requires the Level 22 re-ingestion.
OLLAMA_MODEL=llama3.2:3b

# --- Embeddings --------------------------------------------- (used: Level 5)
# IMPORTANT: nomic-embed-text returns 768-dimension vectors, which must match
# the vector(768) column created at Level 4. src/lib/embeddings.ts checks every
# returned vector and throws on a mismatch rather than storing an unusable one.
# Changing this model changes the dimension and requires the Level 22 reindex.
#
# This model also requires task-instruction prefixes ("search_document: " and
# "search_query: "), which embedDocuments()/embedQuery() apply for you. A
# different model may not need them — check before switching.
#
# Note there are two endpoints and they do NOT return the same thing:
#   POST /api/embed       -> { embeddings: [[...]] }  L2-normalised (norm = 1)
#   POST /api/embeddings  -> { embedding:   [...]  }  raw, NOT normalised
# The code uses /api/embed. Mixing the two corrupts similarity scores.
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Database (Supabase) ------------------------------------- (used: Level 4+)
# Project URL. Dashboard -> Project Settings -> Data API -> Project URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key. Dashboard -> Project Settings -> API Keys -> service_role.
#
# ⚠️  This key BYPASSES Row Level Security. It grants full read/write access to
#     every table. Treat it exactly like a database password:
#       - server-side only, never in a browser bundle
#       - NEVER prefix it with NEXT_PUBLIC_
#       - never paste it into source code, only into .env.local
#     Left blank here on purpose; .env.example is committed.
SUPABASE_SERVICE_ROLE_KEY=

# The browser-safe anon key is deliberately NOT listed. Nothing in the browser
# talks to the database yet, and RLS currently denies the anon role everything.
# It is introduced at Level 13 alongside authentication and RLS policies.

# --- Retrieval ---------------------------------------------- (used: Level 7)
# Maximum chunks returned by a search. Candidates are over-fetched 3x before
# deduplication, so the database sees MATCH_COUNT * 3.
MATCH_COUNT=5

# Minimum cosine SIMILARITY (not distance) a chunk must reach to be returned.
# pgvector's <=> operator gives cosine DISTANCE; match_chunks converts with
# similarity = 1 - distance, so higher is closer and the comparison is >=.
# 0.5 sits in the gap measured at Level 5: relevant 0.797 vs unrelated 0.433.
SIMILARITY_THRESHOLD=0.5

# Character ceiling for the grounded context block handed to the model.
# Documented at Level 23: the code has read this since Level 8 and it was the
# one variable of the 34 missing from this file, flagged in docs/DEPLOYMENT.md.
#
# This is a LATENCY control as much as a quality one. Level 21 measured prompt
# processing at roughly 16 s per 1000 tokens on the reference machine, and this
# ceiling is what bounds how many of those tokens a request can carry. Lowering
# it truncates the least relevant retrieved chunks first.
#
# Must be >= 500; anything smaller is rejected at startup rather than silently
# clamped. Unset means the built-in default.
RAG_MAX_CONTEXT_CHARS=6000

# --- Hybrid search ------------------------------------------ (used: Level 9)
# Reciprocal Rank Fusion constant. 60 is the value from the original RRF paper;
# larger values flatten the influence of top-ranked positions.
RRF_K=60

# Candidates drawn from EACH arm (vector and full-text) before fusion. Must
# exceed MATCH_COUNT so a chunk ranked low by one arm can be rescued by the other.
HYBRID_CANDIDATES=30

# --- Reranking ---------------------------------------------- (used: Level 10)
# Reranking reorders a larger candidate set before the top MATCH_COUNT chunks
# reach the prompt. It is a quality stage, never a correctness one: if it fails,
# is disabled, or times out, retrieval falls back to the Level 9 fused order and
# the chatbot answers normally.
#
# DEFAULT OFF, from measurement rather than preference. On the Level 10 fixture
# the lexical reranker left every metric exactly where Level 9 had it (top-1
# 87.5%, hit@5 100%, MRR 0.9375; 0 improved, 0 degraded across 16 queries).
# A stage not shown to help should not sit in the request path. Re-measure on
# your own corpus with `npm run verify:rerank` before turning it on.
RERANK_ENABLED=false

# "lexical" — local, no model call, sub-millisecond, cannot fail.
# "llm"     — true cross-encoder scoring through the LLM provider. Measured at
#             0.7-10.4 s PER CANDIDATE on this hardware (llama3.2:3b) depending
#             on passage length and cache warmth — 14-155 s for 20 candidates.
#             Ollama 0.30.11 also exposes no reranking endpoint. Implemented and
#             selectable, but not usable interactively here. See
#             src/lib/rerank/llm.ts for the full measurements.
RERANK_STRATEGY=lexical

# Candidates fetched for the reranker to choose from ("first retrieve a larger
# candidate set"). Must exceed MATCH_COUNT or there is nothing to rerank.
# Capped at 100 by MAX_MATCH_COUNT in src/lib/retrieval.ts.
RERANK_CANDIDATES=20

# Wall-clock budget for the rerank stage. On overrun the fused order is used.
RERANK_TIMEOUT_MS=5000

# --- Conversation memory ------------------------------------ (used: Level 12)
# Bounds on how much prior conversation is sent to the model. ROADMAP.md Level 12
# requires a context strategy: "Do not send unlimited conversation history."
#
# Both limits apply and the tighter one wins — ten short turns and ten long ones
# are very different prompts, so bounding only the count would not bound cost.
CONVERSATION_MAX_TURNS=10
CONVERSATION_MAX_HISTORY_CHARS=4000

# Ceiling on the text handed to the summariser. The summariser is itself a model
# call, so without its own bound the work avoided in the answer prompt would
# simply reappear here. Oldest turns are dropped first.
CONVERSATION_SUMMARY_INPUT_CHARS=6000

# --- Authentication ----------------------------------------- (used: Level 13)
# The anon (publishable) key. Dashboard -> Project Settings -> API Keys -> anon.
#
# Unlike the service-role key this one is designed to be publishable: it grants
# nothing on its own, because Row Level Security decides what the bearer may
# see. It is still left un-prefixed rather than NEXT_PUBLIC_, because nothing in
# the browser needs it — every Supabase call is made by the server, and auth
# tokens live in httpOnly cookies the page cannot read.
#
# Without this, authentication is reported as unconfigured and the application
# runs anonymously exactly as it did at Level 12.
SUPABASE_ANON_KEY=

# --- Abuse protection --------------------------------------- (used: Level 14)
# Inference is self-hosted: there is no elastic capacity behind this app, and a
# single answer occupies both CPU cores for ~30s. One caller in a loop does not
# raise a bill, it makes the service unusable for everyone.
#
# Counters live IN MEMORY in this process. They reset on restart and do not
# coordinate across instances — run two copies and the effective limits double.
# That is a deliberate trade for a single self-hosted process; a shared store
# would mean Redis (Rule 9) or a database round trip on every request.
RATE_LIMIT_ENABLED=true

# Trust X-Forwarded-For for the client address.
#
# FALSE by default, and that matters: the header is attacker-controlled unless a
# reverse proxy OVERWRITES it, so keying limits on it would let a caller mint a
# fresh budget per request. While false, anonymous callers are keyed on the
# server-issued httpOnly session cookie (evadable by discarding cookies), and
# the CONCURRENCY limit is the real backstop — it counts work actually in
# flight, which no header can lie about.
#
# Set true ONLY behind a proxy you control that rewrites the header.
RATE_LIMIT_TRUST_PROXY=false

# Refill window, in seconds, for every bucket below.
RATE_LIMIT_WINDOW_SECONDS=3600

# Requests per window. Anonymous is stricter throughout.
# Chat is the expensive one: 60/hour is roughly half an hour of solid inference.
RATE_LIMIT_CHAT_ANONYMOUS=10
RATE_LIMIT_CHAT_AUTHENTICATED=60

# Uploads run extraction plus one embedding call per chunk. Anonymous users
# cannot upload at all, so their budget is zero.
RATE_LIMIT_UPLOAD_ANONYMOUS=0
RATE_LIMIT_UPLOAD_AUTHENTICATED=20

# Credential endpoints, where someone would sit and guess.
RATE_LIMIT_AUTH=10

# Cheap indexed reads: listing chats and documents, session checks.
RATE_LIMIT_READ_ANONYMOUS=120
RATE_LIMIT_READ_AUTHENTICATED=300

# Simultaneous requests occupying the model (chat generation, upload embedding).
# Ollama serves one at a time on two cores; without a cap, concurrent callers
# queue inside Ollama and all of them time out. Over the cap returns 429 rather
# than queueing, so a caller learns immediately instead of holding a socket.
RATE_LIMIT_MAX_CONCURRENT=2
RATE_LIMIT_MAX_CONCURRENT_ANONYMOUS=1

# JSON body ceiling, checked from Content-Length BEFORE parsing. 128 KB
# comfortably holds the 24,000-character conversation Level 3 permits.
MAX_REQUEST_BYTES=131072

# Output ceiling per answer (num_predict). Bounds how long one question can
# occupy the model.
GENERATION_MAX_TOKENS_ANONYMOUS=384
GENERATION_MAX_TOKENS_AUTHENTICATED=512

# --- Public security ---------------------------------------- (used: Level 16)
# Upstream timeouts. Before these existed, a stalled Ollama held a request open
# until the client gave up — and because a request also holds one of the Level 14
# concurrency slots, TWO stalls could take the whole service down and leave every
# later caller seeing 429 indefinitely. These are what make the concurrency
# limiter recoverable rather than a latch.
#
# Total-duration budgets covering the response and the streamed body, not idle
# timeouts. 120s sits well clear of the measured p95 of 43-66s (Level 11), and
# generation length is separately bounded by GENERATION_MAX_TOKENS_*.
OLLAMA_TIMEOUT_MS=120000

# Embedding is faster and runs during uploads, which also hold a slot.
# Generous against the measured ~1.6s per batch (Level 5).
OLLAMA_EMBED_TIMEOUT_MS=30000

# Security headers and CSP are set in next.config.ts, not here — they are not
# per-deployment configuration. See docs/DEPLOYMENT.md for what Level 16 does
# and does not make safe.

# --- Embeddable widget --------------------------------------- (used: Level 17)
# Which websites may embed the chat widget. Comma-separated http(s) ORIGINS —
# scheme and host only, no path and no trailing slash. Maximum 20 entries.
#
#   WIDGET_ALLOWED_ORIGINS=https://example.com,https://www.example.com
#
# FAIL CLOSED. Unset or empty means the widget is DISABLED: `/embed` answers
# 404, its `frame-ancestors` stays `'none'`, and every request carrying the
# `X-Widget-Origin` header is refused with 403. There is no wildcard and no
# "allow anything in development" — add the development origin explicitly.
#
# Origins are exact. `http://localhost:5100` and `http://127.0.0.1:5100` are
# DIFFERENT origins, as are http and https, and so is a non-default port. Case,
# a trailing slash, a default port (:80 / :443) and a unicode hostname are all
# normalised, so those spellings cannot be used to slip past the list.
#
# READ AT BUILD TIME as well as per request, and those are different moments.
# Next.js bakes next.config.ts `headers()` into .next/routes-manifest.json
# during `next build`; `next start` serves that manifest and never re-reads it.
# So changing this requires a REBUILD, not just a restart. The server-side
# checks on /embed and /api/chat DO read it per request, so a restart without a
# rebuild leaves the two halves disagreeing (the widget then loads but cannot
# chat, or cannot load at all). `npm run verify:widget` fails on that mismatch.
# An entry that is not a valid origin fails the build rather than being skipped.
#
# This is a BROWSER-side control plus a server-side allowlist check on the API.
# It stops an unapproved website displaying the widget and stops it spending
# another site's budget. It cannot stop a non-browser caller reaching /api/chat
# directly — that is what the rate limit below and the concurrency cap are for.
WIDGET_ALLOWED_ORIGINS=

# Widget messages per window, per ALLOWLISTED SITE — not per visitor. The
# widget receives no cookies in a third-party iframe, so visitors of one site
# cannot be told apart and share this budget; one abusive visitor can spend a
# site's hourly allowance. Sized above the anonymous chat limit (10) because
# this bounds a whole website rather than one person, and still far below the
# ~230/hour this hardware could theoretically serve.
RATE_LIMIT_WIDGET=60

# --- Admin dashboard ----------------------------------------- (used: Level 18)
# Who may open /admin. Comma-separated email addresses, matched against the
# address on the SERVER-VERIFIED Supabase session — never against anything a
# caller sends. Compared lowercased, because auth.ts lowercases on sign-up.
#
#   ADMIN_EMAILS=you@example.com,ops@example.com
#
# FAIL CLOSED. Unset or empty means NOBODY is an admin and /admin returns 404
# for everyone, including signed-in users. There is no default account, no
# "first user wins", and no development bypass.
#
# /admin answers 404 rather than 403 in every unauthorised case, so a visitor
# is not told that the page exists and they merely lack rights.
#
# The account must exist in Supabase Auth and be signed in; this variable
# grants nothing on its own. Level 18 adds no admin API — /admin is a server
# component, so there is no /api/admin/* endpoint to protect.
ADMIN_EMAILS=

# --- Offline / zero-API mode --------------------------------- (used: Level 20)
# ZERO_API_MODE=true makes "no paid AI API calls" an ENFORCED guarantee rather
# than a description. With it on, src/lib/llm.ts refuses any provider that is
# not local — today that means anything other than "ollama", and it will refuse
# a future cloud adapter too, because the check is on the provider being local
# rather than on a list of known-bad names.
#
# It does NOT switch local inference on. The default configuration is already
# fully local: Ollama generates, nomic-embed-text embeds, and retrieval is SQL
# against Postgres + pgvector. What the flag removes is the ability to
# configure your way OUT of that, which is why it defaults to false — Level 19
# deliberately allows a provider to be swapped, and defaulting this to true
# would silently forbid that.
#
# The admin dashboard displays "Inference mode / Provider / Model" either way,
# and says explicitly whether the guarantee is enforced or merely currently
# true. A typo such as "ture" is a startup error, not a quiet opt-out.
ZERO_API_MODE=false
